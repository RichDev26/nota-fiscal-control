generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model PessoaFiscal {
  id                 String   @id @default(cuid())
  nomeRazaoSocial    String?
  nomeFantasia       String?
  cpfCnpj            String?
  endereco           String?
  numero             String?
  complemento        String?
  bairro             String?
  cep                String?
  municipio          String?
  uf                 String?
  email              String?
  telefone           String?
  celular            String?
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  site               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  notasComoPrestador NotaFiscal[] @relation("Prestador")
  notasComoTomador   NotaFiscal[] @relation("Tomador")
}

model NotaFiscal {
  id                            String    @id @default(cuid())
  nomeOrganizador               String?
  tipo                          String?
  numeroNf                      String?
  numeroRps                     String?
  codigoVerificacao             String?
  of                            String?
  descricao                     String?
  dataEmissao                   DateTime?
  dataFatoGerador               DateTime?
  dataVencimento                DateTime?
  dataRecebimento               DateTime?
  status                        String    @default("rascunho")
  valorBruto                    Float?
  valorLiquido                  Float?
  aliquota                      Float?
  valorIss                      Float?
  baseCalculo                   Float?
  valorLiquidoAntecipacao       Float?
  valorTotalTributosAntecipacao Float?
  metodoAntecipacao             String?   // 'DIRECT_FEE' | 'RATE_AND_DAYS'
  taxaAntecipacao               Float?    // só quando metodoAntecipacao = RATE_AND_DAYS
  diasAntecipacao               Float?    // só quando metodoAntecipacao = RATE_AND_DAYS
  ir                            Float?
  pisPasep                      Float?
  cofins                        Float?
  inss                          Float?
  csll                          Float?
  outrasRetencoes               Float?
  valorAproximadoTributos       Float?
  naturezaOperacao              String?
  situacaoTributariaIssqn       String?
  localPrestacao                String?
  situacaoNfse                  String?
  observacoesFiscais            String?
  regimeTributario              String?
  indicacaoRetencao             String?
  observacoesAutenticidade      String?
  municipioEmissor              String?
  codigoServico                 String?
  quantidade                    Float?
  valorUnitario                 Float?
  observacoes                   String?
  arquivoPdfUrl                 String?
  pdfData                       String?
  tags                          String?
  prestadorId                   String?
  tomadorId                     String?
  notaSubstitutivaId            String?
  usuarioId                     String?

  prestador         PessoaFiscal?        @relation("Prestador", fields: [prestadorId], references: [id])
  tomador           PessoaFiscal?        @relation("Tomador", fields: [tomadorId], references: [id])
  notaSubstitutiva  NotaFiscal?          @relation("Substituicao", fields: [notaSubstitutivaId], references: [id])
  notasSubstituidas NotaFiscal[]         @relation("Substituicao")
  impostos          Imposto[]
  historico         HistoricoAlteracao[]
  usuario           Usuario?             @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Imposto {
  id             String      @id @default(cuid())
  mesReferencia  String?
  dataVencimento DateTime?
  dataPagamento  DateTime?
  imposto        String?
  valor          Float?
  status         String      @default("pendente")
  observacao     String?
  notaFiscalId   String?
  usuarioId      String?
  notaFiscal     NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  usuario        Usuario?    @relation(fields: [usuarioId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model HistoricoAlteracao {
  id            String     @id @default(cuid())
  notaFiscalId  String
  campoAlterado String?
  valorAntigo   String?
  valorNovo     String?
  usuario       String?
  dataAcao      DateTime   @default(now())
  notaFiscal    NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
}

// ─── FASE 12 — Fila de Processamento de Produção ──────────────────────────────

model JobFila {
  id               String    @id @default(cuid())
  tipo             String
  status           String    @default("PENDENTE")
  prioridade       Int       @default(5)
  tentativas       Int       @default(0)
  maxTentativas    Int       @default(3)
  documentoId      String?
  arquivoHash      String?
  payload          String    @default("{}")
  resultado        String?
  erro             String?
  workerId         String?
  iniciadoEm       DateTime?
  concluidoEm      DateTime?
  proximaTentativa DateTime?
  timeoutSegundos  Int       @default(120)
  dependencias     String    @default("[]")
  versaoMotor      String    @default("12.0.0")
  usuarioId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, proximaTentativa, prioridade])
  @@index([documentoId])
  @@index([arquivoHash])
}

model MetricaFila {
  id         String   @id @default(cuid())
  nome       String
  valor      Float
  unidade    String?
  dimensoes  String?
  periodoMin Int      @default(1)
  timestamp  DateTime @default(now())

  @@index([nome, timestamp])
}

model AlertaFila {
  id          String    @id @default(cuid())
  tipo        String
  severidade  String
  mensagem    String
  detalhes    String?
  resolvido   Boolean   @default(false)
  resolvidoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tipo, resolvido])
  @@index([severidade, resolvido])
}

// ─── Parte 4 — Persistência entre deploys ─────────────────────────────────────

model BaseConhecimentoDb {
  id        String   @id @default("singleton")
  dados     String
  versao    String
  updatedAt DateTime @updatedAt
}

model CorrecaoLogDb {
  id        String   @id
  dados     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventoAuditoria {
  id         String   @id
  timestamp  DateTime
  categoria  String
  severidade String
  dados      String
  createdAt  DateTime @default(now())

  @@index([categoria, timestamp])
  @@index([severidade, timestamp])
}

model LogSistema {
  id        String   @id @default(cuid())
  tipo      String
  nivel     String?
  dados     String
  timestamp DateTime @default(now())

  @@index([tipo, timestamp])
}

// ─── Autenticação ─────────────────────────────────────────────────────────────

model Usuario {
  id           String       @id @default(cuid())
  email        String       @unique
  senhaHash    String
  nome         String
  criadoEm    DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  notas        NotaFiscal[]
  impostos     Imposto[]
}
