# PostgreSQL local via Docker (rodar: docker-compose up -d)
DATABASE_URL="postgresql://nfcontrol:nfcontrol@localhost:5432/nfcontrol"

# PostgreSQL produção (Railway preenche automaticamente)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Uploads temporários (fora de public/ para não expor sem autenticação)
# Dev: ./tmp/uploads | Prod: ./data/uploads (definido automaticamente pelo NODE_ENV)

# E-mail do administrador do sistema (acesso aos endpoints /api/fila/*)
ADMIN_EMAIL="seu@email.com"

# SMTP — notificações por e-mail do Controle de Integração (opcional; sem isso
# configurado, o app funciona normalmente mas não envia e-mails)
SMTP_HOST="smtp.seuservidor.com"
SMTP_PORT="587"
SMTP_USER="seu@email.com"
SMTP_PASS="sua-senha-ou-app-password"
SMTP_FROM="WorkPro Control <notificacoes@seudominio.com>"

# Intervalo do sweep de notificações em ms (padrão: 1h = 3600000)
# INTEGRACAO_SWEEP_INTERVALO_MS="3600000"

# Segredo do endpoint interno /api/colaboradores/sweep (chamado pelo próprio
# servidor, sem sessão de usuário — recomendado definir em produção)
# SWEEP_SECRET="uma-string-aleatoria-longa"
